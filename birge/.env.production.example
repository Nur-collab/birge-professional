# Production API base URL without a trailing slash.
# Set VITE_API_URL in the hosting provider's production environment.
VITE_API_URL=https://birge-api.onrender.com

# Optional Sentry error monitoring (DSN is public for browser SDKs).
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=production
VITE_SENTRY_RELEASE=
# Optional build-time auth token for uploading Vite source maps to Sentry.
SENTRY_AUTH_TOKEN=
