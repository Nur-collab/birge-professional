# API base URL without a trailing slash.
VITE_API_URL=http://127.0.0.1:8000

# Auth is always requested from the same-origin /api/auth proxy: Vite
# forwards it to VITE_API_URL locally, vercel.json forwards it in production.

# Optional Sentry error monitoring (DSN is public for browser SDKs).
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=
VITE_SENTRY_RELEASE=
