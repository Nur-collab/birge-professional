# development | test | production
ENVIRONMENT=development

# Required in production. Generate with:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# Required in production. Encrypts MBank phone/ElKart number at rest.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
PII_ENCRYPTION_KEY=
# Optional separate key for OTP hashing; defaults to SECRET_KEY.
OTP_HASH_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# PostgreSQL in production, SQLite locally.
DATABASE_URL=sqlite:///./birge.db

# Comma-separated exact origins allowed by CORS.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional regex for preview deployments; leave empty in production if possible.
CORS_ORIGIN_REGEX=

# Telegram bot and webhook.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ADMIN_CHAT_ID=

# Comma-separated phone numbers allowed to call /admin endpoints.
ADMIN_PHONES=

# Server-side profile photo upload (ImgBB).
IMGBB_API_KEY=

# Development-only Telegram binding sync endpoint.
INTERNAL_SYNC_ENABLED=false
INTERNAL_SYNC_SECRET=

# Shared rate limits and SSE/WebSocket Pub/Sub. Leave empty for one process.
REDIS_URL=

# Logging. Production always emits JSON; LOG_JSON forces JSON locally.
LOG_LEVEL=INFO
LOG_JSON=false

# Optional Sentry error monitoring. Empty DSN disables Sentry.
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_TRACES_SAMPLE_RATE=0.05
